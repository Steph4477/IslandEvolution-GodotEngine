[gd_scene format=3 uid="uid://dapglwcq0g0b4"]

[sub_resource type="GDScript" id="GDScript_msolp"]
script/source = "extends Node2D


# --- Config ---
@export var max_value = 100

# --- Nodes ---
@onready var bar = $ProgressBar


func _ready():
	bar.max_value = max_value
	bar.value = max_value
	set_red_fill()


# ============================================================================
#                               UPDATE VALUE
# ============================================================================
func set_value(v):
	bar.value = clamp(v, 0, max_value)


# ============================================================================
#                               SYNC MAX HP
# ============================================================================
func set_max(v):
	max_value = v
	bar.max_value = max_value
	bar.value = max_value


# ============================================================================
#                               STYLE
# ============================================================================
func set_red_fill():
	var red_fill = StyleBoxFlat.new()
	red_fill.bg_color = Color(1.0, 0.0, 0.0)
	bar.add_theme_stylebox_override(\"fill\", red_fill)
"

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_msolp"]

